# Copy to .env.local and fill in. Never commit real values.

# Clerk (dashboard → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...): server only, used by the automatic course check
SUPABASE_SERVICE_ROLE_KEY=

# Lesson safety: the secret Vapi sends with the tutor's "jelentes" tool calls
# (a long random string, at least 24 characters; the same value goes into the
# tool's Bearer Token credential in Vapi). See docs/vapi-lesson-safety.md
VAPI_TOOL_SECRET=

# OpenAI (platform.openai.com → API keys): the free moderation model
OPENAI_API_KEY=

# Vapi (dashboard → API keys → public key). Restrict it to your domain there
NEXT_PUBLIC_VAPI_WEB_TOKEN=
# Optional: other saved assistants than the defaults in lib/ai/assistants.ts
# NEXT_PUBLIC_VAPI_ASSISTANT_HU=
# NEXT_PUBLIC_VAPI_ASSISTANT_EN=
# NEXT_PUBLIC_VAPI_ASSISTANT_DEMO_HU=
# NEXT_PUBLIC_VAPI_ASSISTANT_DEMO_EN=

# ElevenLabs: only for npm run speech:generate, not needed by the app
ELEVENLABS_API_KEY=

# Sentry: only for uploading source maps on Vercel
SENTRY_AUTH_TOKEN=
